      "name": "users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"user_id\" TEXT NOT NULL REFERENCES users (id) ON DELETE RESTRICT, \"name\" TEXT NOT NULL, \"unit\" TEXT NOT NULL, \"minimum_stock\" INTEGER NOT NULL, \"current_stock\" INTEGER NOT NULL DEFAULT 0 CHECK(\"current_stock\" >= 0), \"description\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "inventory_movements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inventory_movements\" (\"id\" TEXT NOT NULL, \"product_id\" TEXT NOT NULL REFERENCES products (id) ON DELETE RESTRICT, \"user_id\" TEXT NOT NULL REFERENCES users (id) ON DELETE RESTRICT, \"type\" INTEGER NOT NULL, \"reason\" INTEGER NOT NULL, \"quantity\" INTEGER NOT NULL, \"stock_before\" INTEGER NOT NULL, \"stock_after\" INTEGER NOT NULL, \"occurred_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
